# Copy to .env and fill in:  cp .env.example .env
# .env is gitignored. Never put real values in this file.

# --- Claude (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium            # low | medium | high | xhigh | max

# --- PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX       # keep SANDBOX for the hackathon

# --- Phoenix tracing (run: uvx arize-phoenix serve) ---
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=paypal-ai-hackathon
TRACING_ENABLED=true
